# ===== Core =====
APP_NAME=Fire Intelligence Platform
APP_ENV=development
DEBUG=false
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
REGISTRATION_ENABLED=true
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=admin123456
DATABASE_URL=sqlite:///./data/app.db
# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/fire_intelligence

# ===== Storage (local | s3 | supabase) =====
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=./data/storage
# S3_STORAGE_BUCKET=
# S3_ENDPOINT_URL=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# SUPABASE_URL=
# SUPABASE_SERVICE_KEY=
# SUPABASE_STORAGE_BUCKET=

# ===== AI (OpenAI-compatible) =====
OPENAI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
VISION_MODEL=
OCR_MODEL=
SPEECH_MODEL=
EMBEDDING_MODEL=
RERANK_MODEL=
RERANK_BASE_URL=
AI_TIMEOUT_SECONDS=120

# ===== RAG =====
VECTOR_STORE_PROVIDER=local
RAG_TOP_K=8
RAG_RERANK_TOP_K=4

# ===== Tasks =====
TASK_WORKER_IN_PROCESS=true
TASK_POLL_INTERVAL_SECONDS=2
TASK_MAX_RETRIES=3
TASK_BACKOFF_SECONDS=5

# ===== Limits =====
MAX_VIDEO_SIZE_MB=500
MAX_AUDIO_SIZE_MB=200
MAX_DOC_SIZE_MB=50
MAX_IMAGE_SIZE_MB=20
