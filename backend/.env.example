# Fire Intelligence Platform 后端配置（示例）

# 数据库：默认本地 SQLite；生产使用 PostgreSQL
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/fire（需安装 postgres extra: pip install .[postgres]）
DATABASE_URL=sqlite:///./data/app.db

# JWT（生产环境必须替换为强随机值）
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS 允许来源（逗号分隔）
CORS_ORIGINS=http://localhost:3000

# 是否开放注册
REGISTRATION_ENABLED=true

# 存储（local 为默认本地文件系统实现）
STORAGE_PROVIDER=local
STORAGE_DIR=./data/storage

# 业务规则
REMARKS_MAX_LENGTH=2000

# AI 能力配置（留空表示未配置；未配置时相关任务/请求会以可读错误失败，不会编造结果。
# 全部走 OpenAI 兼容 HTTP API，Base URL 必须显式配置，禁止硬编码模型名与密钥）
AI_LLM_API_KEY=
AI_LLM_MODEL=
AI_LLM_BASE_URL=
AI_VISION_API_KEY=
AI_VISION_MODEL=
AI_VISION_BASE_URL=
AI_OCR_API_KEY=
AI_OCR_MODEL=
AI_OCR_BASE_URL=
AI_SPEECH_API_KEY=
AI_SPEECH_MODEL=
AI_SPEECH_BASE_URL=
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_MODEL=
AI_EMBEDDING_BASE_URL=
AI_RERANKER_API_KEY=
AI_RERANKER_MODEL=
AI_RERANKER_BASE_URL=
# AI HTTP 调用：超时（秒）与重试次数
AI_HTTP_TIMEOUT_SECONDS=60
AI_HTTP_MAX_RETRIES=2

# MCP（M8）：JSON 数组 [{"name","url","token_ref"?}]，token_ref 只存密钥环境变量名
MCP_SERVERS=
MCP_TIMEOUT_SECONDS=15

# Agent / 多智能体（M8）：单 Agent 最大步数、子任务数上限、总超时（秒）
AGENT_MAX_STEPS=8
AGENT_MAX_SUBTASKS=4
AGENT_TIMEOUT_SECONDS=120

# 评估（M8）：逐题超时保护（秒）
EVAL_QUESTION_TIMEOUT_SECONDS=60

# 媒体处理：视频抽帧间隔（秒）、入档关键帧上限、临时工作区目录（用后清理）
MEDIA_FRAME_INTERVAL_SECONDS=2.0
MEDIA_MAX_KEY_FRAMES=12
MEDIA_TEMP_DIR=./data/temporary

# 向量库（local=内置 SQLite+numpy 本地实现；chroma=可选，需安装 chromadb）
VECTOR_STORE_PROVIDER=local
VECTOR_STORE_DIR=./data/vectorstore

# RAG 检索参数（候选 top-k / 送入 LLM 的来源数）
RAG_RETRIEVAL_TOP_K=8
RAG_CONTEXT_TOP_N=5

# 异步任务执行器（in_process=开发态进程内线程池）
TASK_EXECUTOR=in_process
# 执行器并发 worker 数（进程内线程池大小）
EXECUTOR_WORKERS=2
# 任务重试上限：第 max_attempts 次尝试仍失败即死信（RETRY_EXHAUSTED）
TASK_MAX_ATTEMPTS=3
# worker 租约时长（秒）：阶段推进时续约；过期未续约视为卡住，由 reaper 恢复
TASK_LEASE_SECONDS=300
# reaper 周期扫描间隔（秒）；应用启动时也会立即执行一次恢复
TASK_REAPER_INTERVAL_SECONDS=60

# --- M7 平台工程化 ---

# PostgreSQL 连接池（仅 DATABASE_URL 为 PostgreSQL 时生效）
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# 启动时自动执行 alembic upgrade head（测试环境关闭）
AUTO_MIGRATE=true
# 默认管理员种子：两者同时设置且邮箱不存在时创建 role=admin 用户（密码不落日志）
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=

# 只读聚合端点（statistics / knowledge status）进程内 TTL 缓存秒数
CACHE_TTL_SECONDS=30

# S3 兼容对象存储（STORAGE_PROVIDER=s3 或 supabase；需安装 s3 extra: pip install .[s3]）
# Supabase：将 S3_ENDPOINT_URL 指向 Supabase Storage 的 S3 兼容端点
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
